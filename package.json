{
  "name": "fizlab",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "db:start": "npx --yes supabase@2.117.0 start --network-id fizlab-local",
    "db:stop": "npx --yes supabase@2.117.0 stop",
    "db:status": "npx --yes supabase@2.117.0 status",
    "gen:content-index": "node scripts/build-content-index.mjs",
    "prebuild": "npm run gen:content-index",
    "build": "tsc -b && vite build --mode site --outDir dist/client && node scripts/package-site.mjs",
    "prebuild:site": "npm run gen:content-index",
    "build:site": "tsc -b && vite build --mode site --outDir dist/client && node scripts/package-site.mjs",
    "build:android": "node scripts/check-mobile-api.mjs && npm run gen:content-index && tsc -b && vite build --mode mobile --outDir dist/client && npx cap sync android",
    "android:open": "npx cap open android",
    "lint": "oxlint",
    "test:smoke": "node scripts/smoke.mjs",
    "test:server": "node scripts/test-server.mjs",
    "start:site": "node scripts/serve-site.mjs",
    "preview": "vite preview --outDir dist/client",
    "typecheck": "tsc -b",
    "test": "npm run test:server && npm run test:progress && npm run test:auth-client && npm run test:auth-mutations && npm run test:content && npm run test:simulation-math && npm run test:tooling && npm run test:billing && npm run test:email && npm run test:subscription-client && npm run test:billing-client && npm run test:admin && npm run test:account-access-client",
    "test:progress": "node scripts/test-progress.mjs",
    "test:auth-client": "node scripts/test-auth-client.mjs",
    "test:auth-mutations": "node scripts/test-auth-mutations.mjs",
    "test:content": "node scripts/test-content.mjs",
    "test:simulation-math": "node scripts/test-simulation-math.mjs",
    "test:tooling": "node scripts/test-tooling.mjs && node --test scripts/server-env.test.mjs",
    "test:e2e": "node scripts/test-e2e.mjs",
    "audit:ui": "node scripts/test-ui.mjs",
    "test:billing": "node --test server/billing.test.mjs server/billing.integration.test.mjs",
    "test:security": "node --test server/security.test.mjs server/http.test.mjs",
    "test:email": "node --test server/authEmail.test.mjs",
    "test:subscription-client": "node scripts/test-subscription-client.mjs",
    "test:billing-client": "node scripts/test-billing-client.mjs",
    "check:release": "node scripts/check-release.mjs",
    "test:commerce": "node scripts/test-commerce.mjs",
    "test:admin": "node --test server/admin.test.mjs",
    "test:account-access-client": "node scripts/test-account-access-client.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.17",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "@react-three/rapier": "^2.2.0",
    "@revenuecat/purchases-capacitor": "13.6.1",
    "@supabase/supabase-js": "^2.110.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "gsap": "^3.15.0",
    "katex": "^0.17.0",
    "lenis": "^1.3.25",
    "leva": "^0.10.1",
    "lucide-react": "^0.550.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-katex": "^3.1.0",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.9.2",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@capacitor/cli": "^8.5.2",
    "@tailwindcss/vite": "^4.3.2",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-katex": "^3.0.4",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^5.2.0",
    "oxlint": "^1.71.0",
    "playwright": "^1.61.1",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.2",
    "vite": "^7.3.6"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "react-katex": {
      "katex": "$katex"
    },
    "xcode": {
      "uuid": "^11.1.1"
    }
  }
}
